{
  "expo": {
    "name": "Animist",
    "slug": "Animist",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/animistIcon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.fnyz.animist",
      "supportsTablet": true
    },
    "android": {
      "package": "com.fnyz.animist",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1112"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/FinalSplash.png",
          "resizeMode": "cover",
          "backgroundColor": "#0E0F14"
        }
      ],
      "expo-image"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "725d4e25-16ef-4564-8c3c-c5b3f02f3a59"
      }
    },
    "owner": "piattos_44",
    "updates": {
      "url": "https://u.expo.dev/725d4e25-16ef-4564-8c3c-c5b3f02f3a59"
    }
  }
}
