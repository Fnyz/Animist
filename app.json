{
  "expo": {
    "name": "Animist",
    "slug": "Animist",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/animistIcon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.fnyz.animist",
      "supportsTablet": true
    },
    "android": {
      "package": "com.fnyz.animist",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0F14"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/FinalSplash.png",
          "resizeMode": "cover",
          "backgroundColor": "#0E0F14"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
