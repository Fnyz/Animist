{
  // Fails CI on any high or critical vulnerability in packages the app uses.
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "skip-dev": true,
  "allowlist": [
    // braces <=3.0.3: no fixed version exists yet. Used only by the Metro bundler at build time.
    "GHSA-vfj7-8cjw-p6xm",
    // node-forge <=1.4.0: no fixed version exists yet. Used only by Expo's CLI and update signing at build time.
    "GHSA-86w9-cpqp-85rv"
  ]
}
