# Copy this file to .env and fill in your own values. .env is git-ignored.

# YouTube Data API v3 key, used only by scripts/find-episodes.js on your computer
# (never shipped in the app). Create it in Google Cloud Console > APIs & Services > Credentials.
YOUTUBE_API_KEY=

# Sentry DSN for crash reports (optional): sentry.io > your project > Settings > Client Keys (DSN).
# It's public by design (every installed app contains it). Leave empty to turn crash reporting off.
# In GitHub Actions, set it as the repository variable SENTRY_DSN instead.
# Never put secret keys in EXPO_PUBLIC_ variables: they're built into the app.
EXPO_PUBLIC_SENTRY_DSN=
